# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and not converted to native line endings on checkout.
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf

# Denote all binary files that should not be modified by Git.
*.png binary
*.ttf binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
